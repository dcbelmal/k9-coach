<?xml version="1.0" encoding="utf-8"?>
<!--
  Zasady kopii danych (Android 11 i starsze): kopia na konto Google wyłączona
  dla wszystkich danych aplikacji (profile psów, dokumenty, zdjęcia, trasy GPS).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
